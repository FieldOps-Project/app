{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "local": {
      "distribution": "internal",
      "developmentClient": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8080"
      }
    },
    "integration": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "integration",
        "EXPO_PUBLIC_API_URL": "https://api.integracao.fieldops.example"
      }
    },
    "demo": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "demo",
        "EXPO_PUBLIC_API_URL": "https://api.demo.fieldops.example"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.fieldops.example"
      }
    }
  }
}
