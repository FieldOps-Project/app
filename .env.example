# Copie este arquivo para .env e ajuste os valores.
#
# ATENÇÃO: tudo que começa com EXPO_PUBLIC_ é embutido no bundle e fica visível
# para quem tiver o aplicativo instalado. Nunca coloque senha, chave de API,
# token ou credencial de banco aqui.
#
# URL base da API REST, sem barra no final.
#   Emulador Android:  http://10.0.2.2:8080
#   Simulador iOS:     http://localhost:8080
#   Aparelho físico:   http://<SEU-IP-LOCAL>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Ambiente lógico da build: development | staging | production
EXPO_PUBLIC_APP_ENV=development
